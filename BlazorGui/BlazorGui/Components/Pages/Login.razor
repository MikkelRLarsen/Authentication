@page "/login"
@using System.Net
@inject NavigationManager _navManager
@inject IHttpClientFactory ClientFactory
@rendermode InteractiveServer

<h3>Login</h3>

<input @bind="username" placeholder="Username" />
<input @bind="password" placeholder="Password" type="password" />
<button @onclick="LoginHandler">Login</button>

<p>@message</p>

@code {
    string username = "";
    string password = "";
    string message = "";

    async Task LoginHandler()
    {
        HttpClient client = ClientFactory.CreateClient("AuthenticationService");

        var response = await client.PostAsJsonAsync("auth/login", new { username, password });

        if (response.IsSuccessStatusCode)
        {
            _navManager.NavigateTo("counter");
        }
        else if (response.StatusCode == HttpStatusCode.TooManyRequests)
        {
            var retryAfter = response.Headers.RetryAfter?.Delta?.TotalSeconds ?? 10;
            message = $"For mange forsøg — prøv igen om {retryAfter:N0} sekunder.";
        }
        else
        {
            message = "Wrong password";
        }
    }

    async Task HandleShortCut(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await LoginHandler();
        }
    }
}